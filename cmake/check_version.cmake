# cmake -P cmake/check_version.cmake: fails when README.md's install snippets don't match the version in
# CMakeLists.txt. The book substitutes its version; the README is plain Markdown, so it's checked instead.
cmake_minimum_required(VERSION 3.25)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(STRINGS "${root}/CMakeLists.txt" line REGEX "^project\\(raydom VERSION")
string(REGEX MATCH "([0-9]+)\\.([0-9]+)\\.([0-9]+)" version "${line}")
set(minor "${CMAKE_MATCH_1}.${CMAKE_MATCH_2}")
file(READ "${root}/README.md" readme)
set(failed FALSE)
foreach (want "GIT_TAG        v${version})" "find_package(raydom ${minor} CONFIG REQUIRED)")
    string(FIND "${readme}" "${want}" at)
    if (at EQUAL -1)
        message(SEND_ERROR "README.md should contain `${want}` for version ${version}")
        set(failed TRUE)
    endif ()
endforeach ()
if (NOT failed)
    message(STATUS "README.md matches version ${version}")
endif ()
